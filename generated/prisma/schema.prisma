generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model UserProfile {
  id                String   @id @default(cuid())
  clerkId           String   @unique
  userId            String   @unique
  firstName         String
  lastName          String
  otherNames        String?
  displayName       String
  username          String   @unique
  primaryEmail      String
  alternateEmail    String?
  phoneNumber       String?
  workPhone         String?
  alternatePhone    String?
  profilePhoto      String?
  country           String?
  stateRegion       String?
  cityTown          String?
  streetAddress     String?
  postalCode        String?
  emergencyName     String?
  emergencyPhone    String?
  emergencyRelation String?
  profileComplete   Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  notifications Notification[]
  activities    Activity[]

  @@index([clerkId])
  @@index([username])
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  type        String
  title       String
  description String
  read        Boolean  @default(false)
  pinned      Boolean  @default(false)
  actionUrl   String?
  actionLabel String?
  createdAt   DateTime @default(now())

  user UserProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
  @@index([read])
}

model Activity {
  id          String   @id @default(cuid())
  userId      String
  workspaceId String?
  type        String
  title       String
  description String?
  metadata    String?
  actionUrl   String?
  createdAt   DateTime @default(now())

  user UserProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
  @@index([workspaceId])
  @@index([createdAt])
}

model Workspace {
  id          String    @id @default(cuid())
  name        String
  type        String
  industry    String?
  country     String?
  employees   String?
  currency    String?
  description String?
  status      String?
  startDate   DateTime?
  endDate     DateTime?
  ownerId     String
  slug        String    @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  members         WorkspaceMember[]
  invites         WorkspaceInvite[]
  businessDetails BusinessDetails?
  editRequests    EditRequest[]
  pendingChanges  PendingChange[]
  departments     Department[]
  delegates       WorkspaceDelegate[]
  financeSettings FinanceSettings?
  accounts        FinanceAccount[]
  transactions    Transaction[]
  invoices        Invoice[]
  budgets         Budget[]
  payrollRecords  PayrollRecord[]
  journalEntries  JournalEntry[]
  taxRecords      TaxRecord[]
  products        Product[]
  customers       Customer[]
  suppliers       Supplier[]
  purchaseOrders  PurchaseOrder[]
  salesOrders     SalesOrder[]
  stockMovements  StockMovement[]

  @@index([ownerId])
}

model WorkspaceMember {
  id              String    @id @default(cuid())
  workspaceId     String
  userId          String
  role            String
  departmentId    String?
  invitedBy       String?
  approvalStatus  String    @default("approved")
  approvedBy      String?
  approvedAt      DateTime?
  personalMessage String?
  createdAt       DateTime  @default(now())

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id])

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([departmentId])
  @@index([approvalStatus])
}

model WorkspaceInvite {
  id              String   @id @default(cuid())
  workspaceId     String
  email           String
  role            String
  departmentId    String?
  invitedBy       String
  personalMessage String?
  token           String   @unique @default(cuid())
  accepted        Boolean  @default(false)
  createdAt       DateTime @default(now())
  expiresAt       DateTime

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([token])
  @@index([invitedBy])
}

model Department {
  id                 String    @id @default(cuid())
  workspaceId        String
  name               String
  description        String?
  headUserId         String?
  parentDepartmentId String?
  status             String    @default("pending")
  createdBy          String
  approvedBy         String?
  approvedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members          WorkspaceMember[]
  parentDepartment Department?       @relation("DepartmentHierarchy", fields: [parentDepartmentId], references: [id])
  subDepartments   Department[]      @relation("DepartmentHierarchy")

  @@index([workspaceId])
  @@index([status])
  @@index([parentDepartmentId])
}

model WorkspaceDelegate {
  id                    String   @id @default(cuid())
  workspaceId           String
  delegateUserId        String
  delegatedBy           String
  canApproveDepartments Boolean  @default(true)
  canApproveMembers     Boolean  @default(true)
  canApproveChanges     Boolean  @default(true)
  canInviteMembers      Boolean  @default(true)
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, delegateUserId])
  @@index([workspaceId])
  @@index([delegateUserId])
}

model BusinessDetails {
  id                 String   @id @default(cuid())
  workspaceId        String   @unique
  logo               String?
  registrationNumber String?
  legalStructure     String?
  yearFounded        String?
  businessEmail      String?
  businessPhone      String?
  websiteUrl         String?
  physicalAddress    String?
  mission            String?
  vision             String?
  coreValues         String?
  operatingHours     String?
  linkedin           String?
  twitter            String?
  facebook           String?
  instagram          String?
  otherSocial        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model EditRequest {
  id          String   @id @default(cuid())
  workspaceId String
  requesterId String
  reason      String
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([requesterId])
  @@index([status])
}

model PendingChange {
  id          String   @id @default(cuid())
  workspaceId String
  submittedBy String
  fieldName   String
  oldValue    String?
  newValue    String
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([submittedBy])
  @@index([status])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  read           Boolean  @default(false)
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
}

model Conversation {
  id             String    @id @default(cuid())
  participantOne String
  participantTwo String
  lastMessage    String?
  lastMessageAt  DateTime?
  createdAt      DateTime  @default(now())

  messages Message[]

  @@unique([participantOne, participantTwo])
  @@index([participantOne])
  @@index([participantTwo])
}

// ─── FINANCE MODELS ───────────────────────────────────────

model FinanceSettings {
  id              String  @id @default(cuid())
  workspaceId     String  @unique
  isSetup         Boolean @default(false)
  fiscalYearStart String  @default("January")
  defaultCurrency String  @default("USD")

  // Core features
  enableInvoicing       Boolean @default(false)
  enableAccounts        Boolean @default(false)
  enableBudgets         Boolean @default(false)
  enableTax             Boolean @default(false)
  enablePayroll         Boolean @default(false)
  enablePayables        Boolean @default(false)
  enableMultiCurrency   Boolean @default(false)
  enableDoubleEntry     Boolean @default(false)
  enableJournalEntries  Boolean @default(false)
  enableAuditTrail      Boolean @default(false)
  enableAdvancedReports Boolean @default(false)

  // New features
  enableInventory      Boolean @default(false)
  enablePurchaseOrders Boolean @default(false)
  enableSalesOrders    Boolean @default(false)
  enableCustomers      Boolean @default(false)
  enableSuppliers      Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model FinanceAccount {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  type        String
  // Types: cash, bank, credit, receivable,
  //        payable, equity, revenue, expense
  code        String?
  currency    String   @default("USD")
  balance     Float    @default(0)
  description String?
  isActive    Boolean  @default(true)
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  journalLines JournalLine[]

  @@index([workspaceId])
  @@index([type])
}

model Transaction {
  id            String   @id @default(cuid())
  workspaceId   String
  accountId     String?
  type          String
  // Types: income, expense, transfer
  amount        Float
  currency      String   @default("USD")
  exchangeRate  Float    @default(1)
  category      String
  subCategory   String?
  description   String
  reference     String?
  date          DateTime
  attachmentUrl String?
  taxAmount     Float?
  taxRate       Float?
  departmentId  String?
  createdBy     String
  aiCategorized Boolean  @default(false)
  aiInsight     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account   FinanceAccount? @relation(fields: [accountId], references: [id])

  @@index([workspaceId])
  @@index([type])
  @@index([category])
  @@index([date])
  @@index([createdBy])
}

model Invoice {
  id            String    @id @default(cuid())
  workspaceId   String
  invoiceNumber String
  customerId    String?
  clientName    String
  clientEmail   String?
  clientAddress String?
  clientPhone   String?
  items         String
  // JSON array of line items
  subtotal      Float
  taxRate       Float     @default(0)
  taxAmount     Float     @default(0)
  discount      Float     @default(0)
  total         Float
  currency      String    @default("USD")
  status        String    @default("draft")
  // Status: draft, sent, paid, overdue, cancelled
  dueDate       DateTime?
  paidDate      DateTime?
  paidAmount    Float?
  notes         String?
  terms         String?
  attachmentUrl String?
  aiGenerated   Boolean   @default(false)
  createdBy     String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customer  Customer? @relation(fields: [customerId], references: [id])

  @@index([workspaceId])
  @@index([status])
  @@index([clientName])
  @@index([dueDate])
}

model Budget {
  id            String   @id @default(cuid())
  workspaceId   String
  name          String
  category      String
  amount        Float
  spent         Float    @default(0)
  currency      String   @default("USD")
  period        String
  startDate     DateTime
  endDate       DateTime
  departmentId  String?
  alertAt       Float    @default(80)
  notes         String?
  aiRecommended Boolean  @default(false)
  createdBy     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([category])
  @@index([period])
}

model PayrollRecord {
  id              String    @id @default(cuid())
  workspaceId     String
  employeeId      String
  employeeName    String
  period          String
  basicSalary     Float
  allowances      String?
  deductions      String?
  grossPay        Float
  totalDeductions Float
  netPay          Float
  currency        String    @default("USD")
  status          String    @default("pending")
  paidDate        DateTime?
  payslipUrl      String?
  notes           String?
  createdBy       String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([employeeId])
  @@index([period])
  @@index([status])
}

model JournalEntry {
  id          String    @id @default(cuid())
  workspaceId String
  entryNumber String
  date        DateTime
  description String
  reference   String?
  status      String    @default("draft")
  createdBy   String
  postedBy    String?
  postedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lines     JournalLine[]

  @@index([workspaceId])
  @@index([date])
  @@index([status])
}

model JournalLine {
  id             String   @id @default(cuid())
  journalEntryId String
  accountId      String
  description    String?
  debit          Float    @default(0)
  credit         Float    @default(0)
  createdAt      DateTime @default(now())

  journalEntry JournalEntry   @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      FinanceAccount @relation(fields: [accountId], references: [id])

  @@index([journalEntryId])
  @@index([accountId])
}

model TaxRecord {
  id           String    @id @default(cuid())
  workspaceId  String
  name         String
  taxType      String
  rate         Float
  period       String
  totalTaxable Float
  taxAmount    Float
  status       String    @default("pending")
  dueDate      DateTime?
  filedDate    DateTime?
  paidDate     DateTime?
  notes        String?
  createdBy    String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([taxType])
  @@index([status])
}

model AuditLog {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  action      String
  entityType  String
  entityId    String
  oldValues   String?
  newValues   String?
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([workspaceId])
  @@index([userId])
  @@index([entityType])
  @@index([createdAt])
}

// ─── INVENTORY & COMMERCE MODELS ──────────────────────────

model Product {
  id           String   @id @default(cuid())
  workspaceId  String
  name         String
  sku          String?
  // Stock Keeping Unit
  barcode      String?
  category     String?
  description  String?
  unit         String   @default("piece")
  // e.g. piece, kg, litre, box, dozen
  costPrice    Float    @default(0)
  // How much you buy it for
  sellingPrice Float    @default(0)
  // How much you sell it for
  currentStock Float    @default(0)
  minimumStock Float    @default(0)
  // Alert when stock falls below this
  maximumStock Float?
  supplierId   String?
  imageUrl     String?
  isActive     Boolean  @default(true)
  aiInsight    String?
  // AI generated insight e.g. fast moving item
  createdBy    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace      Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  supplier       Supplier?           @relation(fields: [supplierId], references: [id])
  stockMovements StockMovement[]
  purchaseItems  PurchaseOrderItem[]
  salesItems     SalesOrderItem[]

  @@index([workspaceId])
  @@index([sku])
  @@index([category])
  @@index([supplierId])
}

model StockMovement {
  id          String   @id @default(cuid())
  workspaceId String
  productId   String
  type        String
  // Types: purchase, sale, adjustment,
  //        return, damage, transfer
  quantity    Float
  unitCost    Float?
  totalCost   Float?
  reference   String?
  // Order number or reference
  notes       String?
  createdBy   String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([productId])
  @@index([type])
  @@index([createdAt])
}

model Customer {
  id                 String   @id @default(cuid())
  workspaceId        String
  name               String
  email              String?
  phone              String?
  alternatePhone     String?
  address            String?
  city               String?
  country            String?
  taxNumber          String?
  creditLimit        Float    @default(0)
  outstandingBalance Float    @default(0)
  totalPurchases     Float    @default(0)
  notes              String?
  isActive           Boolean  @default(true)
  createdBy          String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  salesOrders SalesOrder[]
  invoices    Invoice[]

  @@index([workspaceId])
  @@index([name])
  @@index([email])
}

model Supplier {
  id                 String   @id @default(cuid())
  workspaceId        String
  name               String
  email              String?
  phone              String?
  alternatePhone     String?
  address            String?
  city               String?
  country            String?
  taxNumber          String?
  paymentTerms       String?
  // e.g. Net 30, Net 60, Cash on delivery
  outstandingBalance Float    @default(0)
  totalPurchases     Float    @default(0)
  notes              String?
  isActive           Boolean  @default(true)
  createdBy          String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  purchaseOrders PurchaseOrder[]
  products       Product[]

  @@index([workspaceId])
  @@index([name])
}

model PurchaseOrder {
  id           String    @id @default(cuid())
  workspaceId  String
  orderNumber  String
  supplierId   String
  status       String    @default("draft")
  // Status: draft, sent, confirmed,
  //         received, partial, cancelled
  subtotal     Float     @default(0)
  taxAmount    Float     @default(0)
  discount     Float     @default(0)
  total        Float     @default(0)
  currency     String    @default("USD")
  expectedDate DateTime?
  receivedDate DateTime?
  notes        String?
  createdBy    String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  workspace Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  supplier  Supplier            @relation(fields: [supplierId], references: [id])
  items     PurchaseOrderItem[]

  @@index([workspaceId])
  @@index([supplierId])
  @@index([status])
}

model PurchaseOrderItem {
  id              String   @id @default(cuid())
  purchaseOrderId String
  productId       String
  description     String?
  quantity        Float
  unitCost        Float
  totalCost       Float
  receivedQty     Float    @default(0)
  createdAt       DateTime @default(now())

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id])

  @@index([purchaseOrderId])
  @@index([productId])
}

model SalesOrder {
  id              String    @id @default(cuid())
  workspaceId     String
  orderNumber     String
  customerId      String?
  customerName    String
  status          String    @default("draft")
  // Status: draft, confirmed, processing,
  //         shipped, delivered, cancelled
  subtotal        Float     @default(0)
  taxAmount       Float     @default(0)
  discount        Float     @default(0)
  total           Float     @default(0)
  currency        String    @default("USD")
  deliveryDate    DateTime?
  deliveredDate   DateTime?
  deliveryAddress String?
  notes           String?
  createdBy       String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customer  Customer?        @relation(fields: [customerId], references: [id])
  items     SalesOrderItem[]

  @@index([workspaceId])
  @@index([customerId])
  @@index([status])
}

model SalesOrderItem {
  id           String   @id @default(cuid())
  salesOrderId String
  productId    String
  description  String?
  quantity     Float
  unitPrice    Float
  totalPrice   Float
  createdAt    DateTime @default(now())

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id])

  @@index([salesOrderId])
  @@index([productId])
}
