generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model UserProfile {
  id                String   @id @default(cuid())
  clerkId           String   @unique
  userId            String   @unique
  firstName         String
  lastName          String
  otherNames        String?
  displayName       String
  username          String   @unique
  primaryEmail      String
  alternateEmail    String?
  phoneNumber       String?
  workPhone         String?
  alternatePhone    String?
  profilePhoto      String?
  country           String?
  stateRegion       String?
  cityTown          String?
  streetAddress     String?
  postalCode        String?
  emergencyName     String?
  emergencyPhone    String?
  emergencyRelation String?
  profileComplete   Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  notifications Notification[]
  activities    Activity[]

  @@index([clerkId])
  @@index([username])
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  type        String
  title       String
  description String
  read        Boolean  @default(false)
  pinned      Boolean  @default(false)
  actionUrl   String?
  actionLabel String?
  createdAt   DateTime @default(now())

  user UserProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
  @@index([read])
}

model Activity {
  id          String   @id @default(cuid())
  userId      String
  workspaceId String?
  type        String
  title       String
  description String?
  metadata    String?
  actionUrl   String?
  createdAt   DateTime @default(now())

  user UserProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
  @@index([workspaceId])
  @@index([createdAt])
}

model Workspace {
  id          String    @id @default(cuid())
  name        String
  type        String
  industry    String?
  country     String?
  employees   String?
  currency    String?
  description String?
  status      String?
  startDate   DateTime?
  endDate     DateTime?
  ownerId     String
  slug        String    @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  members         WorkspaceMember[]
  invites         WorkspaceInvite[]
  businessDetails BusinessDetails?
  editRequests    EditRequest[]
  pendingChanges  PendingChange[]
  departments     Department[]
  delegates       WorkspaceDelegate[]
  financeSettings FinanceSettings?
  accounts        FinanceAccount[]
  transactions    Transaction[]
  invoices        Invoice[]
  budgets         Budget[]
  payrollRecords  PayrollRecord[]
  journalEntries  JournalEntry[]
  taxRecords      TaxRecord[]

  @@index([ownerId])
}

model WorkspaceMember {
  id              String    @id @default(cuid())
  workspaceId     String
  userId          String
  role            String
  departmentId    String?
  invitedBy       String?
  approvalStatus  String    @default("approved")
  approvedBy      String?
  approvedAt      DateTime?
  personalMessage String?
  createdAt       DateTime  @default(now())

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id])

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([departmentId])
  @@index([approvalStatus])
}

model WorkspaceInvite {
  id              String   @id @default(cuid())
  workspaceId     String
  email           String
  role            String
  departmentId    String?
  invitedBy       String
  personalMessage String?
  token           String   @unique @default(cuid())
  accepted        Boolean  @default(false)
  createdAt       DateTime @default(now())
  expiresAt       DateTime

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([token])
  @@index([invitedBy])
}

model Department {
  id                 String    @id @default(cuid())
  workspaceId        String
  name               String
  description        String?
  headUserId         String?
  parentDepartmentId String?
  status             String    @default("pending")
  createdBy          String
  approvedBy         String?
  approvedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members          WorkspaceMember[]
  parentDepartment Department?       @relation("DepartmentHierarchy", fields: [parentDepartmentId], references: [id])
  subDepartments   Department[]      @relation("DepartmentHierarchy")

  @@index([workspaceId])
  @@index([status])
  @@index([parentDepartmentId])
}

model WorkspaceDelegate {
  id                    String   @id @default(cuid())
  workspaceId           String
  delegateUserId        String
  delegatedBy           String
  canApproveDepartments Boolean  @default(true)
  canApproveMembers     Boolean  @default(true)
  canApproveChanges     Boolean  @default(true)
  canInviteMembers      Boolean  @default(true)
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, delegateUserId])
  @@index([workspaceId])
  @@index([delegateUserId])
}

model BusinessDetails {
  id                 String   @id @default(cuid())
  workspaceId        String   @unique
  logo               String?
  registrationNumber String?
  legalStructure     String?
  yearFounded        String?
  businessEmail      String?
  businessPhone      String?
  websiteUrl         String?
  physicalAddress    String?
  mission            String?
  vision             String?
  coreValues         String?
  operatingHours     String?
  linkedin           String?
  twitter            String?
  facebook           String?
  instagram          String?
  otherSocial        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model EditRequest {
  id          String   @id @default(cuid())
  workspaceId String
  requesterId String
  reason      String
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([requesterId])
  @@index([status])
}

model PendingChange {
  id          String   @id @default(cuid())
  workspaceId String
  submittedBy String
  fieldName   String
  oldValue    String?
  newValue    String
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([submittedBy])
  @@index([status])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  read           Boolean  @default(false)
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
}

model Conversation {
  id             String    @id @default(cuid())
  participantOne String
  participantTwo String
  lastMessage    String?
  lastMessageAt  DateTime?
  createdAt      DateTime  @default(now())

  messages Message[]

  @@unique([participantOne, participantTwo])
  @@index([participantOne])
  @@index([participantTwo])
}

// ─── FINANCE MODELS ───────────────────────────────────────

model FinanceSettings {
  id              String  @id @default(cuid())
  workspaceId     String  @unique
  isSetup         Boolean @default(false)
  fiscalYearStart String  @default("January")
  defaultCurrency String  @default("USD")

  // Feature flags — user selects these
  enableInvoicing       Boolean @default(false)
  enableAccounts        Boolean @default(false)
  enableBudgets         Boolean @default(false)
  enableTax             Boolean @default(false)
  enablePayroll         Boolean @default(false)
  enablePayables        Boolean @default(false)
  enableMultiCurrency   Boolean @default(false)
  enableDoubleEntry     Boolean @default(false)
  enableJournalEntries  Boolean @default(false)
  enableAuditTrail      Boolean @default(false)
  enableAdvancedReports Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model FinanceAccount {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  // e.g. Main Bank Account, Petty Cash
  type        String
  // Types: cash, bank, credit, receivable,
  //        payable, equity, revenue, expense
  code        String?
  // Account code e.g. 1001
  currency    String   @default("USD")
  balance     Float    @default(0)
  description String?
  isActive    Boolean  @default(true)
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  journalLines JournalLine[]

  @@index([workspaceId])
  @@index([type])
}

model Transaction {
  id            String   @id @default(cuid())
  workspaceId   String
  accountId     String?
  type          String
  // Types: income, expense, transfer
  amount        Float
  currency      String   @default("USD")
  exchangeRate  Float    @default(1)
  category      String
  // AI will suggest categories
  subCategory   String?
  description   String
  reference     String?
  // Invoice number, receipt number etc
  date          DateTime
  attachmentUrl String?
  // Receipt photo uploaded via Gemini
  taxAmount     Float?
  taxRate       Float?
  departmentId  String?
  createdBy     String
  aiCategorized Boolean  @default(false)
  // Whether AI auto-categorized this
  aiInsight     String?
  // AI generated insight about this transaction
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account   FinanceAccount? @relation(fields: [accountId], references: [id])

  @@index([workspaceId])
  @@index([type])
  @@index([category])
  @@index([date])
  @@index([createdBy])
}

model Invoice {
  id            String    @id @default(cuid())
  workspaceId   String
  invoiceNumber String
  clientName    String
  clientEmail   String?
  clientAddress String?
  clientPhone   String?
  items         String
  // JSON array of line items
  subtotal      Float
  taxRate       Float     @default(0)
  taxAmount     Float     @default(0)
  discount      Float     @default(0)
  total         Float
  currency      String    @default("USD")
  status        String    @default("draft")
  // Status: draft, sent, paid, overdue, cancelled
  dueDate       DateTime?
  paidDate      DateTime?
  paidAmount    Float?
  notes         String?
  terms         String?
  attachmentUrl String?
  aiGenerated   Boolean   @default(false)
  // Whether AI helped generate this invoice
  createdBy     String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([status])
  @@index([clientName])
  @@index([dueDate])
}

model Budget {
  id            String   @id @default(cuid())
  workspaceId   String
  name          String
  category      String
  amount        Float
  spent         Float    @default(0)
  currency      String   @default("USD")
  period        String
  // monthly, quarterly, yearly
  startDate     DateTime
  endDate       DateTime
  departmentId  String?
  alertAt       Float    @default(80)
  // Alert when spent reaches X% of budget
  notes         String?
  aiRecommended Boolean  @default(false)
  // Whether AI recommended this budget
  createdBy     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([category])
  @@index([period])
}

model PayrollRecord {
  id              String    @id @default(cuid())
  workspaceId     String
  employeeId      String
  // userId of employee
  employeeName    String
  period          String
  // e.g. "January 2025"
  basicSalary     Float
  allowances      String?
  // JSON: {housing, transport, medical}
  deductions      String?
  // JSON: {tax, pension, loan}
  grossPay        Float
  totalDeductions Float
  netPay          Float
  currency        String    @default("USD")
  status          String    @default("pending")
  // Status: pending, approved, paid
  paidDate        DateTime?
  payslipUrl      String?
  notes           String?
  createdBy       String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([employeeId])
  @@index([period])
  @@index([status])
}

model JournalEntry {
  id          String    @id @default(cuid())
  workspaceId String
  entryNumber String
  date        DateTime
  description String
  reference   String?
  status      String    @default("draft")
  // Status: draft, posted, reversed
  createdBy   String
  postedBy    String?
  postedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lines     JournalLine[]

  @@index([workspaceId])
  @@index([date])
  @@index([status])
}

model JournalLine {
  id             String   @id @default(cuid())
  journalEntryId String
  accountId      String
  description    String?
  debit          Float    @default(0)
  credit         Float    @default(0)
  createdAt      DateTime @default(now())

  journalEntry JournalEntry   @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      FinanceAccount @relation(fields: [accountId], references: [id])

  @@index([journalEntryId])
  @@index([accountId])
}

model TaxRecord {
  id           String    @id @default(cuid())
  workspaceId  String
  name         String
  // e.g. VAT, Income Tax, Withholding Tax
  taxType      String
  rate         Float
  period       String
  // e.g. "Q1 2025"
  totalTaxable Float
  taxAmount    Float
  status       String    @default("pending")
  // Status: pending, filed, paid
  dueDate      DateTime?
  filedDate    DateTime?
  paidDate     DateTime?
  notes        String?
  createdBy    String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([taxType])
  @@index([status])
}

model AuditLog {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  action      String
  // e.g. created, updated, deleted, viewed
  entityType  String
  // e.g. Transaction, Invoice, JournalEntry
  entityId    String
  oldValues   String?
  // JSON of old values
  newValues   String?
  // JSON of new values
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([workspaceId])
  @@index([userId])
  @@index([entityType])
  @@index([createdAt])
}
