generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model UserProfile {
  id                String   @id @default(cuid())
  clerkId           String   @unique
  userId            String   @unique
  firstName         String
  lastName          String
  otherNames        String?
  displayName       String
  username          String   @unique
  primaryEmail      String
  alternateEmail    String?
  phoneNumber       String?
  workPhone         String?
  alternatePhone    String?
  profilePhoto      String?
  country           String?
  stateRegion       String?
  cityTown          String?
  streetAddress     String?
  postalCode        String?
  emergencyName     String?
  emergencyPhone    String?
  emergencyRelation String?
  profileComplete   Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  notifications Notification[]
  activities    Activity[]

  @@index([clerkId])
  @@index([username])
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  type        String
  title       String
  description String
  read        Boolean  @default(false)
  pinned      Boolean  @default(false)
  actionUrl   String?
  actionLabel String?
  createdAt   DateTime @default(now())

  user UserProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
  @@index([read])
}

model Activity {
  id          String   @id @default(cuid())
  userId      String
  workspaceId String?
  type        String
  title       String
  description String?
  metadata    String?
  actionUrl   String?
  createdAt   DateTime @default(now())

  user UserProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
  @@index([workspaceId])
  @@index([createdAt])
}

model Workspace {
  id          String    @id @default(cuid())
  name        String
  type        String
  industry    String?
  country     String?
  employees   String?
  currency    String?
  description String?
  status      String?
  startDate   DateTime?
  endDate     DateTime?
  ownerId     String
  slug        String    @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  members         WorkspaceMember[]
  invites         WorkspaceInvite[]
  businessDetails BusinessDetails?
  editRequests    EditRequest[]
  pendingChanges  PendingChange[]
  departments     Department[]
  delegates       WorkspaceDelegate[]

  @@index([ownerId])
}

model WorkspaceMember {
  id              String    @id @default(cuid())
  workspaceId     String
  userId          String
  role            String
  // Roles: owner, co-owner, admin, member, viewer
  departmentId    String?
  // Which department this member belongs to
  invitedBy       String?
  // userId of who invited this member
  approvalStatus  String    @default("approved")
  // Status: pending, approved, rejected
  // owner is always approved by default
  approvedBy      String?
  // userId of who approved this member
  approvedAt      DateTime?
  personalMessage String?
  // Message sent with the invite
  createdAt       DateTime  @default(now())

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id])

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([departmentId])
  @@index([approvalStatus])
}

model WorkspaceInvite {
  id              String   @id @default(cuid())
  workspaceId     String
  email           String
  role            String
  departmentId    String?
  invitedBy       String
  // userId of who sent this invite
  personalMessage String?
  token           String   @unique @default(cuid())
  accepted        Boolean  @default(false)
  createdAt       DateTime @default(now())
  expiresAt       DateTime

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([token])
  @@index([invitedBy])
}

model Department {
  id                 String    @id @default(cuid())
  workspaceId        String
  name               String
  description        String?
  headUserId         String?
  // userId of department head
  parentDepartmentId String?
  // For sub-departments
  status             String    @default("pending")
  // Status: pending, active, archived
  createdBy          String
  approvedBy         String?
  approvedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members          WorkspaceMember[]
  parentDepartment Department?       @relation("DepartmentHierarchy", fields: [parentDepartmentId], references: [id])
  subDepartments   Department[]      @relation("DepartmentHierarchy")

  @@index([workspaceId])
  @@index([status])
  @@index([parentDepartmentId])
}

model WorkspaceDelegate {
  id                    String   @id @default(cuid())
  workspaceId           String
  delegateUserId        String
  // userId of the person being delegated to
  delegatedBy           String
  // userId of owner who delegated
  canApproveDepartments Boolean  @default(true)
  canApproveMembers     Boolean  @default(true)
  canApproveChanges     Boolean  @default(true)
  canInviteMembers      Boolean  @default(true)
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, delegateUserId])
  @@index([workspaceId])
  @@index([delegateUserId])
}

model BusinessDetails {
  id                 String   @id @default(cuid())
  workspaceId        String   @unique
  logo               String?
  registrationNumber String?
  legalStructure     String?
  yearFounded        String?
  businessEmail      String?
  businessPhone      String?
  websiteUrl         String?
  physicalAddress    String?
  mission            String?
  vision             String?
  coreValues         String?
  operatingHours     String?
  linkedin           String?
  twitter            String?
  facebook           String?
  instagram          String?
  otherSocial        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model EditRequest {
  id          String   @id @default(cuid())
  workspaceId String
  requesterId String
  reason      String
  status      String   @default("pending")
  // Status: pending, approved, denied
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([requesterId])
  @@index([status])
}

model PendingChange {
  id          String   @id @default(cuid())
  workspaceId String
  submittedBy String
  fieldName   String
  oldValue    String?
  newValue    String
  status      String   @default("pending")
  // Status: pending, approved, rejected
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([submittedBy])
  @@index([status])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  read           Boolean  @default(false)
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
}

model Conversation {
  id             String    @id @default(cuid())
  participantOne String
  participantTwo String
  lastMessage    String?
  lastMessageAt  DateTime?
  createdAt      DateTime  @default(now())

  messages Message[]

  @@unique([participantOne, participantTwo])
  @@index([participantOne])
  @@index([participantTwo])
}
